# Immutable snapshot used only by apt-install-locked.sh; the base image's own
# /etc/apt sources are left untouched. Snapshot Release files expire, so the
# Valid-Until check is disabled; signatures are still verified with the keyring
# and apt-release.sha256 pins the exact InRelease bytes.
Types: deb
URIs: https://snapshot.debian.org/archive/debian/20260930T082601Z
Suites: trixie trixie-updates
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
Check-Valid-Until: no

Types: deb
URIs: https://snapshot.debian.org/archive/debian-security/20260930T060347Z
Suites: trixie-security
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
Check-Valid-Until: no
