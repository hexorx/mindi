{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "./configure-hermes-buzz.ts",
    "./configure-hermes-computer-use.ts",
    "./configure-hermes-hindsight.ts",
    "./configure-hermes-dashboard.ts",
    "./configure-hermes-webhook.ts",
    "./join-link.ts"
  ]
}
